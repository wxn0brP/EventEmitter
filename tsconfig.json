{
    "compilerOptions": {
        "module": "ES2022",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "paths": {},
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true
    },
    "include": [
       "./src"
    ],
    "exclude": [
        "node_modules"
    ]
}
